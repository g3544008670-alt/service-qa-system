# 复制为 .env 后按需修改；不要把 .env 提交到仓库
# 生成随机值：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 初始账号口令：不填则每次启动随机生成并打印在控制台
DEFAULT_ADMIN_PASSWORD=
DEFAULT_EMPLOYEE_PASSWORD=
DEFAULT_CUSTOMER_PASSWORD=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# 数据库：PostgreSQL 16
DATABASE_URL=postgresql://postgres@localhost:5432/knowledge_base

# 调试模式：设为 1 才会开启 Werkzeug 调试器，生产环境不要开
FLASK_DEBUG=0

# 离线加载嵌入模型（无外网时必须开启，否则启动会卡在连接 huggingface.co）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 邮件（可选，当前版本未启用找回密码）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
